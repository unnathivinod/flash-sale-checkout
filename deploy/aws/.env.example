# Copy to deploy/aws/.env on EVERY EC2 instance and fill in.
# Use the SAME values on all three machines.

# Private IPv4 address of the "data" EC2 instance (EC2 console -> instance -> Private IPv4)
DATA_HOST=172.31.x.x

# Make up long random strings (letters and numbers only)
DB_PASSWORD=changeThisDbPassword123
REDIS_PASSWORD=changeThisRedisPassword123
ADMIN_TOKEN=changeThisAdminToken123
LOADTEST_KEY=changeThisLoadtestKey123
